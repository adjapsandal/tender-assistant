# === LLM / Embeddings ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SIMILARITY_THRESHOLD=0.35

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_THRESHOLD=0.5

# === Tender source credentials ===
ROSTENDER_EMAIL=you@example.com
ROSTENDER_PASSWORD=change-me

# === PostgreSQL (pgvector) ===
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tender

# === Web API auth ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Разрешённые источники для браузера, через запятую
CORS_ORIGINS=http://localhost:5173

# === Runtime ===
DEBUG=false
LOG_LEVEL=INFO
